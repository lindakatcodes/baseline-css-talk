---
import "../styles/index.css";
import { getCollection, type CollectionEntry } from "astro:content";

const herbs = (await getCollection("herbs")).map((entry) => entry.data);
const staples = (await getCollection("staples")).map((entry) => entry.data);
const batches = (await getCollection("batches")).map((entry) => entry.data);

type Herb = CollectionEntry<"herbs">["data"];
type Staple = CollectionEntry<"staples">["data"];

const currentHerbs = herbs.filter((herb) => herb.season === "summer");

const currentBatches = batches.filter((batch) => batch.season === "summer");

const batchCountFor = (id: string) =>
  currentBatches.filter((batch) => batch.ingredientIds.includes(id)).length;

const batchDetails = (id: string) =>
  currentBatches
    .filter((batch) => batch.ingredientIds.includes(id))
    .map((batch) => batch.name);

const currentIngredients: Array<{
  displayName: string;
  stockLevel: number;
  freshnessDays: number;
  batchCount: number;
  batchNames: string[];
}> = [
  ...currentHerbs.map((herb: Herb) => ({
    displayName: herb.pantryName,
    stockLevel: herb.stockLevel,
    freshnessDays: herb.freshnessDays,
    batchCount: batchCountFor(herb.id),
    batchNames: batchDetails(herb.id),
  })),
  ...staples.map((staple: Staple) => ({
    displayName: staple.name,
    stockLevel: staple.stockLevel,
    freshnessDays: staple.freshnessDays,
    batchCount: batchCountFor(staple.id),
    batchNames: batchDetails(staple.id),
  })),
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,300..900;1,300..900&family=Yeseva+One&display=swap"
      rel="stylesheet"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sage & Sundry</title>
  </head>
  <body>
    <header>
      <h1>Sage & Sundry Apothecary</h1>
      <fieldset class="season-options">
        <legend>Current season:</legend>
        <div>
          <input
            type="radio"
            id="spring"
            name="season"
            value="spring"
            checked
          />
          <label for="spring">Spring</label>
        </div>
        <div>
          <input type="radio" id="summer" name="season" value="summer" />
          <label for="summer">Summer</label>
        </div>
        <div>
          <input type="radio" id="fall" name="season" value="fall" />
          <label for="fall">Fall</label>
        </div>
        <div>
          <input type="radio" id="winter" name="season" value="winter" />
          <label for="winter">Winter</label>
        </div>
      </fieldset>
    </header>
    <main>
      <aside class="in-season">
        <div class="title">
          <h2>In season</h2>
          <button id="season-toggle" aria-pressed="false">Details ⇆</button>
        </div>
        <ul>
          <li>
            <div class="key-details">
              <p>Name</p>
              <p>Harvest Window</p>
            </div>
          </li>
          {
            currentHerbs.map((herb) => (
              <li>
                <div class="key-details">
                  <p>{herb.name}</p>
                  <p>{herb.harvestWindow}</p>
                </div>
                <div class="extra-details">
                  <p>{herb.botanicalName}</p>
                  <p>{herb.description}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </aside>
      <section class="pantry">
        <h2>Ingredients in Stock</h2>
        <table>
          <thead>
            <th>Ingredient</th>
            <th>Quantity</th>
            <th>Freshness</th>
            <th>Active batches</th>
          </thead>
          <tbody>
            {
              currentIngredients.map((ingredient, index) => (
                <tr>
                  <td>{ingredient.displayName}</td>
                  <td>{ingredient.stockLevel}</td>
                  <td>{ingredient.freshnessDays} Days</td>
                  <td>
                    <button
                      class="batch-pill"
                      popovertarget={`batch-details-${index}`}
                    >
                      {ingredient.batchCount} Batches
                    </button>
                    <div
                      id={`batch-details-${index}`}
                      class="batch-detail"
                      popover
                    >
                      {ingredient.batchNames.map((name) => (
                        <p>❧ {name}</p>
                      ))}
                    </div>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </section>
      <section class="batches">
        <h2>Actively Cooking</h2>
        {
          currentBatches.map((batch) => (
            <div class="card">
              <p class="card-name">{batch.name}</p>
              <p class="card-time">{batch.daysRemaining} Days until ready</p>
              <p class="card-arrow">{"❯"}</p>
            </div>
          ))
        }
      </section>
    </main>
  </body>
</html>

<script>
  const main = document.querySelector("main");
  const seasonToggle = document.querySelector("#season-toggle");

  seasonToggle?.addEventListener("click", () => {
    const expanded = main?.classList.toggle("season-expanded");
    seasonToggle.setAttribute("aria-pressed", String(expanded));
  });
</script>
