---
import "../styles/index.css";
import { getCollection } from "astro:content";
import type { Season, SeasonalDataItem } from "../types/types";
import Header from "../components/Header.astro";
import InSeasonAside from "../components/InSeasonAside.astro";
import PantrySection from "../components/PantrySection.astro";
import BatchesSection from "../components/BatchesSection.astro";

const herbs = (await getCollection("herbs")).map((entry) => entry.data);
const staples = (await getCollection("staples")).map((entry) => entry.data);
const batches = (await getCollection("batches")).map((entry) => entry.data);
const seasons: Season[] = ["spring", "summer", "autumn", "winter"];

const seasonalData: SeasonalDataItem[] = seasons.map((season) => {
  const currentHerbs = herbs.filter((herb) => herb.season === season);
  const currentBatches = batches.filter((batch) => batch.season === season);

  const batchCountFor = (id: string) =>
    currentBatches.filter((batch) => batch.ingredientIds.includes(id)).length;

  const batchDetails = (id: string) =>
    currentBatches
      .filter((batch) => batch.ingredientIds.includes(id))
      .map((batch) => batch.name);

  const currentIngredients = [
    ...currentHerbs.map((herb) => ({
      displayName: herb.pantryName,
      seasons: [herb.season],
      stockLevel: herb.stockLevel,
      freshnessDays: herb.freshnessDays,
      batchCount: batchCountFor(herb.id),
      batchNames: batchDetails(herb.id),
    })),
    ...staples.map((staple) => ({
      displayName: staple.name,
      seasons: seasons,
      stockLevel: staple.stockLevel,
      freshnessDays: staple.freshnessDays,
      batchCount: batchCountFor(staple.id),
      batchNames: batchDetails(staple.id),
    })),
  ];

  return { season, currentHerbs, currentBatches, currentIngredients };
});
---

<html lang="en" data-view="dashboard">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,300..900;1,300..900&family=Yeseva+One&display=swap"
      rel="stylesheet"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sage & Sundry</title>
  </head>
  <body>
    <Header />
    <main>
      <InSeasonAside seasonalData={seasonalData} />
      <PantrySection seasonalData={seasonalData} />
      <BatchesSection seasonalData={seasonalData} />
    </main>
  </body>
</html>
