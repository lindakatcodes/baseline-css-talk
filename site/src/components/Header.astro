<header>
  <h1>Sage & Sundry Apothecary</h1>
  <fieldset class="season-options">
    <legend>Current season:</legend>
    <div>
      <input type="radio" id="spring" name="season" value="spring" />
      <label for="spring">Spring</label>
    </div>
    <div>
      <input type="radio" id="summer" name="season" value="summer" checked />
      <label for="summer">Summer</label>
    </div>
    <div>
      <input type="radio" id="autumn" name="season" value="autumn" />
      <label for="autumn">Autumn</label>
    </div>
    <div>
      <input type="radio" id="winter" name="season" value="winter" />
      <label for="winter">Winter</label>
    </div>
  </fieldset>
</header>

<style>
  @layer layout {
    header {
      display: flex;
      align-items: center;
      padding-block: var(--space-8);
      padding-inline: var(--space-20);

      & h1 {
        flex-grow: 1;
      }

      & .season-options {
        display: flex;
        gap: var(--space-4);
        margin-block-end: var(--space-2);

        & legend {
          padding-inline: var(--space-2);
        }

        & div {
          inline-size: 5rem;
          padding: var(--space-2) var(--space-4);
          position: relative;
          display: flex;
          justify-content: center;

          & input {
            appearance: none;
            position: absolute;
            top: 50%;
            left: 0;
          }
        }
      }
    }

    @media (width <= 650px) {
      header {
        flex-direction: column;

        & h1 {
          text-align: center;
          margin-block-end: var(--space-6);
        }

        & .season-options {
          margin-block-end: var(--space-6);
        }
      }
    }

    @media (width <= 376px) {
      header {
        & .season-options {
          padding-inline: 0;
          gap: 0;

          & div {
            padding-inline: 0;
          }
        }
      }
    }
  }

  @layer theme {
    header {
      background: var(--accent-color);
      border-bottom: 2px solid var(--text-color);

      & .season-options {
        border: 2px double var(--primary-color);
        border-radius: var(--radius);

        & legend {
          font-size: var(--fsize-small);
        }

        & div:has(:checked) label {
          font-weight: bold;
          text-decoration: 2px solid underline var(--secondary-color);
          text-underline-offset: var(--space-4);
        }
      }
    }
  }
</style>
