---
import type { SeasonalDataItem } from "../types/types";
import BatchList from "../components/BatchList.astro";
import BatchDetail from "../components/BatchDetail.astro";

interface Props {
  seasonalData: SeasonalDataItem[];
}

const { seasonalData } = Astro.props;
---

<section class="batches">
  <h2>Actively Cooking</h2>
  <div id="batches" data-view="dashboard">
    <BatchList seasonalData={seasonalData} />
    <BatchDetail seasonalData={seasonalData} />
  </div>
</section>

<style>
  @layer layout {
    .batches {
      padding-inline: var(--space-12);
      padding-block-end: var(--space-20);
      min-block-size: 60rem;
    }

    @media (width <= 650px) {
      .batches {
        padding-inline: var(--space-6);
      }
    }
  }
</style>

<script>
  const detailPanels = [...document.querySelectorAll(".batch-list-detail")];
  const batchesSection = document.querySelector("#batches") as HTMLElement;

  function openCard(id: string) {
    const activePanel = detailPanels.find(
      (panel) => panel.id === `batch-detail-${id}`,
    );
    activePanel!.classList.toggle("is-active", true);

    document.documentElement.dataset.view = "detail";
    batchesSection.dataset.view = "detail";
  }

  function open(id: string) {
    if (!document.startViewTransition) {
      openCard(id);
      return;
    }
    document.startViewTransition(() => {
      openCard(id);
    });
  }

  function backToList() {
    detailPanels.forEach((panel) => {
      panel.classList.toggle("is-active", false);
    });

    document.documentElement.dataset.view = "dashboard";
    batchesSection.dataset.view = "dashboard";
  }

  function back() {
    if (!document.startViewTransition) {
      backToList();
      return;
    }
    document.startViewTransition(() => {
      backToList();
    });
  }

  batchesSection.addEventListener("click", (event) => {
    const target = event.target as HTMLElement;
    if (!target) return;
    const card = target.closest("[data-batch]") as HTMLElement | null;
    const backBtn = target.closest("[data-back]") as HTMLElement | null;
    if (card) open(card.dataset.batch || "0");
    if (backBtn) back();
  });
</script>
