---
import type { SeasonalDataItem } from "../types/types";

interface Props {
  seasonalData: SeasonalDataItem[];
}

const { seasonalData } = Astro.props;
---

{
  seasonalData.map((data) => {
    return data.currentBatches.map((batch) => (
      <div class="batch-list-detail" id={`batch-detail-${batch.id}`} hidden>
        <button data-back={batch.id}>{"❮"} Back to batch list</button>
        <h3>{batch.name}</h3>
        <div class="info">
          <p class="info-header">Batch Type</p>
          <p class="info-header">Total Days to Craft</p>
          <p class="info-header">Days Remaining</p>
          <p>{batch.form}</p>
          <p>{batch.daysToMake}</p>
          <p>{batch.daysRemaining}</p>
        </div>
        <div class="ingredients">
          <p>Made using these ingredients:</p>
          <ul>
            {batch.ingredientIds.map((ingredient) => {
              const ingredientInfo = data.currentIngredients.find(
                (ingred) => ingred.id === ingredient,
              );
              return (
                <li>
                  <span>❧</span> {ingredientInfo?.displayName || ingredient}
                </li>
              );
            })}
          </ul>
        </div>
        <p class="desc">{batch.description}</p>
      </div>
    ));
  })
}

<style>
  @layer layout {
    .batch-list-detail {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      grid-template-rows: repeat(5, min-content);
      grid-template-areas:
        "button . ."
        "title title title"
        "info info info"
        "ingred ingred ingred"
        "desc desc desc";
      gap: var(--space-8);
      align-items: center;
      padding-block: var(--space-8);
      padding-inline: var(--space-12);
      inline-size: 95%;

      & button {
        grid-area: button;
        justify-self: start;
        padding-inline: var(--space-4);
        padding-block: var(--space-2);
      }

      & h3 {
        grid-area: title;
      }

      & .info {
        grid-area: info;
        display: grid;
        grid-template-columns: subgrid;
        grid-template-rows: 1fr 1fr;
        gap: var(--space-2) var(--space-6);
        justify-items: center;
      }

      & .ingredients {
        grid-area: ingred;

        & p {
          text-align: center;
        }

        & ul {
          list-style-type: none;
          padding-inline-start: 0;
          display: flex;
          justify-content: center;
          gap: var(--space-8);
        }
      }

      & .desc {
        grid-area: desc;
      }
    }

    .batch-list-detail[hidden] {
      display: none;
    }
  }

  @layer theme {
    .batch-list-detail {
      border: 2px solid var(--secondary-color);
      border-radius: var(--radius);
      box-shadow: 1px 2px 4px 1px
        color-mix(in srgb, var(--text-color) 15%, transparent);
      background: color-mix(
        in srgb,
        var(--primary-color) 80%,
        var(--secondary-color)
      );

      & button {
        background: var(--accent-color);
        border: 1px outset var(--primary-color);
        border-radius: var(--radius);
      }

      & h3 {
        font-size: var(--fsize-h3);
        text-align: center;
        text-decoration: 4px dotted underline var(--accent-color);
        text-underline-offset: var(--space-2);
      }

      & .info-header {
        font-weight: bold;
      }

      & .info {
        font-weight: normal;
      }
    }
  }
</style>
